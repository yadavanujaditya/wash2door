# Copy to .env or export in your host. All optional.
PORT=3000
# Admin password. If unset on first run, a random one is generated and printed once.
ADMIN_PASSWORD=
# Where the SQLite file lives (use a persistent disk in production).
DB_PATH=data/washwala.db
# Set to 1 when running behind HTTPS / a proxy (secure cookies, real client IP).
TRUST_PROXY=0
